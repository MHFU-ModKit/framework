TARGET = popo_aggression
OBJS   = src/popo_aggression.o mhfu_framework_stub.o

INCDIR    = ../../include
CFLAGS    = -O2 -G0 -Wall -fno-strict-aliasing -DPOPO_AGGRESSION_NO_WORKER
CXXFLAGS  = $(CFLAGS)
ASFLAGS   = $(CFLAGS)

BUILD_PRX  = 1
PRX_EXPORTS = exports.exp

LIBS = -lpspdebug -lpspdisplay -lpspge -lpspctrl -lpspsdk -lc -lpspuser

PSPSDK = $(shell psp-config --pspsdk-path)

# Declare default goal BEFORE the include and the stub-gen rule so
# `all` (provided by build.mak) is what bare `make` targets — not the
# alphabetically-first rule below.
.DEFAULT_GOAL := all

include $(PSPSDK)/lib/build.mak

# Generate the framework's import stub from the framework's export
# table. psp-build-exports -s writes a <library_name>.S file to the
# current directory (here: mhfu_framework.S, matching PSP_EXPORT_START
# in framework_exports.exp). We assemble it ourselves so the linker
# can resolve mhfu_register_event / mhfu_log / etc. as PSP module
# imports — the framework PRX provides them at runtime.
FRAMEWORK_EXP = ../../framework_exports.exp
mhfu_framework.S: $(FRAMEWORK_EXP)
	psp-build-exports -s $(FRAMEWORK_EXP)

mhfu_framework_stub.o: mhfu_framework.S
	psp-gcc -c $(CFLAGS) -o $@ $<
