# PSP-side build for mhfu_framework.prx (C++ core + statically-linked mods).
# Invoked inside the pspdev/pspdev Docker image (see ./Makefile wrapper).

TARGET = mhfu_framework

# Core framework TUs.
CORE_OBJS = \
  src/core/log.o \
  src/core/region.o \
  src/core/memory.o \
  src/core/entity.o \
  src/core/world.o \
  src/core/monster.o \
  src/core/registry.o \
  src/core/trampoline.o \
  src/core/cave.o \
  src/core/hooks.o \
  src/core/install.o \
  src/core/quest.o \
  src/core/ovl_reloc.o \
  src/core/bigmon_overlay.o \
  src/core/inject.o \
  src/core/capture.o \
  src/core/ai.o \
  src/core/modtable.o \
  src/core/bootstrap.o

# Statically-composed mods come from build/mods.manifest (one path per
# line, relative to mods/; '#' disables). This is the single selector —
# add/remove a mod there, no Makefile edit needed.
MODS     := $(shell grep -vE '^[[:space:]]*(#|$$)' build/mods.manifest)
MOD_OBJS := $(foreach m,$(MODS),mods/$(m)/mod.o)

OBJS = $(CORE_OBJS) $(MOD_OBJS)

# include/ = public SDK; src/core/ = internal.h
INCDIR   = include src/core
# EXTRA_DEFINES: reserved (was -DMHFU_REALHW; the inject region is now auto-picked
# at runtime, so the define is a no-op — kept for the `realhw` wrapper target).
CFLAGS   = -Os -G0 -Wall -fno-strict-aliasing $(EXTRA_DEFINES)
# Light C++ only: no exceptions / RTTI / threadsafe-static guards, so the
# objects link with psp-gcc and pull no libstdc++ runtime.
CXXFLAGS = $(CFLAGS) -std=gnu++17 -fno-exceptions -fno-rtti -fno-threadsafe-statics
ASFLAGS  = $(CFLAGS)

# ★ THE REAL-PSP LOAD FIX: prxexports.o is pspsdk's default syslib export object
# (exports module_start + module_info via a .lib.ent table). build_prx.mak — UNLIKE
# build.mak — does NOT auto-link any export object, so without this the PRX ships an
# EMPTY export table and real PSP firmware REJECTS it ("could not be started
# 0x800200D9", before any code runs). Confirmed by diffing a working psplink PRX: it
# has a 16 B .lib.ent where ours had none. PPSSPP scans for module_info directly and
# loaded ours anyway, which masked the bug for a long time. It must come first (it's
# an object whose module_start/module_info refs resolve from our own objects).
# Then sce stubs, then -llua -lm -lc (Lua references libm/libc to its right).
# build_prx.mak appends -lpspdebug -lpspdisplay -lpspge -lpspctrl.
LIBS = $(PSPSDK)/lib/prxexports.o -lpspsdk -lpspuser -lpspusb -lpspnet -lpspnet_apctl -llua -lm -lc

# build_prx.mak (NOT build.mak) — links with -nostartfiles (NO crt0). We define
# module_start DIRECTLY (bootstrap.cpp) and spawn our own thread (a PPSSPP-parity
# fix from the crt0/main() pattern). The mandatory export above is the separate,
# real-hardware fix.
PSPSDK = $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build_prx.mak

# Real-PSP fix (two parts): the modern pspdev toolchain (GCC 15+, binutils 2.44)
# produces a PRX that old PSP firmware / PRO CFW loadcore rejects with 0x800200D9
# before any code runs (PPSSPP is lenient and loads it; real firmware is not).
#   (1) e_flags carries EF_MIPS_ABI_EABI32 (0x3000) — psp-prxgen copies e_flags
#       verbatim, and an EABI ABI flag is "unsupported" to old loadcore. This is
#       the PRIMARY cause. Cleared post-build by tools/patch_prx_eflags.py (a 4-byte
#       header edit; run by the host-side wrapper Makefile after psp-prxgen).
#   (2) the ALLOC'd .MIPS.abiflags / .reginfo sections — discarded here via the
#       linker script (belt-and-suspenders; old loaders predate these).
# linkfile_nohw.lds = pspsdk's linkfile.prx + that one extra DISCARD line. NOTE the
# .lds extension (NOT .prx): `make clean` does `rm -f *.prx` and would delete the
# script mid-build if it were named .prx. Post-prxgen psp-objcopy on the .prx wipes
# the PT_LOAD program headers, so the linker-script + header-patch combo is the
# clean path.
#
# We rebuild LDFLAGS from scratch (matching what build_prx.mak produces) so we
# control the -T flag precisely and avoid a duplicate-script error.
# -Wl,-G,0 is also required: the prebuilt liblua.a in pspdev images >= 2025-06
# was compiled with small-data enabled; without a matching GP threshold of 0 the
# linker emits R_MIPS_GPREL16 overflow errors when linking our large PRX.
LIBDIR_FLAGS := $(addprefix -L,$(LIBDIR))
override LDFLAGS := $(LIBDIR_FLAGS) -Wl,-q,-T$(CURDIR)/linkfile_nohw.lds -nostartfiles -Wl,-zmax-page-size=128 -Wl,-G,0

# Lua scripts embedded into lua_host. Source of truth = the .lua files; the
# generated .lua.h are committed so the Docker build needs no python. After
# editing a .lua, regenerate on the HOST with `make -f Makefile.psp embed`.
# Declared AFTER build.mak so `all` stays the default goal.
LUA_SRC   := $(wildcard mods/lua_host/scripts/*.lua)
LUA_EMBED := $(LUA_SRC:.lua=.lua.h)

.PHONY: embed
embed: $(LUA_EMBED)
mods/lua_host/scripts/%.lua.h: mods/lua_host/scripts/%.lua
	python3 ../../tools/embed_lua.py $< $@

# lua_host/mod.cpp #includes the generated headers — make doesn't auto-track
# that, and `clean` doesn't remove mods/**/*.o, so without this the object
# goes stale and edits to a .lua silently never recompile. Force the dep.
mods/lua_host/mod.o: $(LUA_EMBED)
