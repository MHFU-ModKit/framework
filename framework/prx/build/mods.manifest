# Mods statically composed into mhfu_framework.prx.
#
# One mod per line, path relative to mods/. Lines starting with # are
# disabled. The Makefile turns each entry into mods/<entry>/mod.o.

# --- Big monsters ----------------------------------------------------------
# bigmon_dup: §48 2-group split (2 same-family Tigrex). The N>2 group test PROVED
# the engine caps at 2 target groups structurally (target[2] @+0x7C0 isn't a real
# slot; writing it corrupts adjacent quest data -> kills small monsters). OFF —
# the >2-damaging-monster path is megatigrex clones + resolve_attack (below).
# bigmon_dup

# --- Lua platform ----------------------------------------------------------
# lua_host runs the memstick scripts (ms0:/PSP/PLUGINS/mhfu_framework/mods/*.lua),
# e.g. scripts/megatigrex.lua (3-Tigrex swarm + per-clone resolve_attack damage).
# Ships the entity_clone / quest_* / resolve_attack bindings the swarm needs.
# Keep the C tigrex_spin OFF (both claim the vt[8] chain).
lua_host

# --- HUD ---------------------------------------------------------------------
# monster_nameplates: projected name+HP labels over monsters; double-tap SELECT.
monster_nameplates

# --- disabled --------------------------------------------------------------
# tigrex_spin   # C baseline; crashes on spin via action_decided ptr-force
# noop          # core-only bisect build (kept for future isolation)
# diag
# tigrex_inject
# ai_publish
# popo_growth
# popo_aggression
# experimental/ai_demo
# experimental/popo_vt8_override
# experimental/popo_vt5_freeze
# experimental/popo_heading_hook
